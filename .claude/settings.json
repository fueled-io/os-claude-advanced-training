{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash .claude/skills/check-setup/scripts/check-setup.sh)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git remote -v)",
      "Bash(git --version)",
      "Bash(gh --version)",
      "Bash(gh auth status)",
      "Bash(gh repo set-default --view)",
      "Bash(claude --version)"
    ],
    "deny": [
      "Bash(git push upstream *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
